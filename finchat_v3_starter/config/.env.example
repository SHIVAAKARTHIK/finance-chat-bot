# Names only. Put values in backend/.env (never commit it).

# AWS Bedrock
AWS_REGION=
BEDROCK_MODEL_SQL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_RESPONSE=openai.gpt-oss-120b-1:0
# plus your usual AWS credentials mechanism (profile, role or keys)

# Databricks (service principal only)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=lakehouse_mvpai
DATABRICKS_SCHEMA=aiops
DATABRICKS_AUTH=azure_spn
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DATABRICKS_MCP_URL=https://<workspace-host>/api/2.0/mcp/sql

# Agent budgets
AGENT_MAX_STEPS=15
AGENT_MAX_SECONDS=300
AGENT_MAX_SQL_CALLS=10
SQL_ROW_LIMIT=1000
SQL_ROWS_TO_MODEL=50
CONVERSATION_QUESTION_LIMIT=30
SUMMARY_TOKEN_THRESHOLD=6000

# Access file
RBAC_FILE=config/rbac.v3.yaml

# Tests
RUN_LIVE=0
