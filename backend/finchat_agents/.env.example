# Names only. Put values in backend/.env (never commit it).

# AWS Bedrock
AWS_REGION=
# Credentials: EITHER explicit keys (read from this file and passed to the SDKs directly; they win over a profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            (only for temporary keys)
# OR a named profile from ~/.aws/config (e.g. after `aws sso login --profile <name>`), or an instance role
AWS_PROFILE=
BEDROCK_MODEL_SQL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_RESPONSE=openai.gpt-oss-120b-1:0
# plus your usual AWS credentials mechanism (profile, role or keys)

# Databricks (service principal only)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=lakehouse_mvpai
# v3 always writes to schema aiops (fixed in code); a DATABRICKS_SCHEMA in a shared .env is ignored
DATABRICKS_AUTH=azure_spn
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DATABRICKS_MCP_URL=https://<workspace-host>/api/2.0/mcp/sql

# Agent budgets
AGENT_MAX_STEPS=15
AGENT_MAX_SECONDS=300
AGENT_MAX_SQL_CALLS=10
SQL_ROW_LIMIT=1000
SQL_ROWS_TO_MODEL=50
CONVERSATION_QUESTION_LIMIT=30
SUMMARY_TOKEN_THRESHOLD=6000

# Access file
RBAC_FILE=config/rbac.v3.yaml

# Tests
RUN_LIVE=0

# Added in v3 task 01 (names only)
# gpt-oss transport: converse (boto3 Converse, default) or openai (openai SDK on Bedrock's OpenAI-compatible endpoint)
GPT_OSS_TRANSPORT=converse
LLM_TIMEOUT_SECONDS=120
# Trace JSON-lines folder (relative to backend/finchat_agents)
TRACE_DIR=traces

# Added in v3 task 03 (names only; defaults shown)
SQL_TIMEOUT_SECONDS=60
MCP_POLL_INTERVAL_SECONDS=1
COLUMN_VALUES_CACHE_SECONDS=3600
# AZURE_DATABRICKS_SCOPE defaults to the Azure Databricks resource scope; override only if needed

# Added in v3 tasks 06-10 (names only; defaults shown)
OUTPUT_DIR=outputs
SUMMARY_METRICS_FILE=config/summary_metrics.yaml
WARM_UP_ON_START=true
WARM_UP_TIMEOUT_SECONDS=180
HEALTH_CACHE_SECONDS=60
